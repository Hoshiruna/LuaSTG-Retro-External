{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "cacheVariables": {
        "CPM_SOURCE_CACHE": {
          "type": "PATH",
          "value": "${sourceDir}/build/packages"
        },
        "LSTGEXT_BUILD": "all"
      }
    },
    {
      "name": "vs2022-x86",
      "inherits": "base",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/x86"
    },
    {
      "name": "vs2022-amd64",
      "inherits": "base",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/amd64"
    },
    {
      "name": "vs2022-arm64",
      "inherits": "base",
      "architecture": "ARM64",
      "binaryDir": "${sourceDir}/build/arm64"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x86-release",
      "configurePreset": "vs2022-x86",
      "configuration": "Release",
      "targets": ["zip-install"]
    },
    {
      "name": "windows-amd64-release",
      "configurePreset": "vs2022-amd64",
      "configuration": "Release",
      "targets": ["zip-install"]
    },
    {
      "name": "windows-arm64-release",
      "configurePreset": "vs2022-arm64",
      "configuration": "Release",
      "targets": ["zip-install"]
    }
  ]
}
